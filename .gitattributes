# Normalize line endings so Unity YAML and C# stay readable in diffs
* text=auto

*.cs text diff=csharp
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text
*.anim text
*.controller text
*.json text
*.md text

*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.dll binary
*.exe binary
*.pdb binary
*.ttf binary
*.otf binary
